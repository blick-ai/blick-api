# ===========================================
# BLICK Backend — Variáveis de Ambiente
# ===========================================

# Aplicação
APP_NAME=BLICK Backend
APP_ENV=development
DEBUG=true

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blick_db

# Segurança
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]
